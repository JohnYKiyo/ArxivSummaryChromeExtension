# =============================================================================
# Required for the React web UI; optional for Chrome-extension-only setups
# =============================================================================

# Google Gemini API key — get one at https://aistudio.google.com/apikey
# Used by the web UI (React frontend). The Chrome extension instead supplies
# the key per request via the ``X-Google-Api-Key`` header (configured in the
# popup's settings panel) and does not consult this value, so it can be left
# empty for extension-only setups.
GOOGLE_API_KEY=your-google-api-key

# LLM model. Use a GA model name (preview names like *-preview-MM-DD expire).
#   gemini-2.5-pro    — highest quality, slower, stricter rate limits
#   gemini-2.5-flash  — faster and cheaper; recommended for development
LLM_MODEL=gemini-2.5-pro


# =============================================================================
# Local development defaults — leave as-is for `docker compose up`
# =============================================================================

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# DynamoDB table name (DynamoDB Local is auto-configured by docker-compose;
# DYNAMODB_ENDPOINT_URL is injected there, no need to set it here).
DYNAMODB_TABLE_NAME=arxiv-translator-jobs


# =============================================================================
# Production-only — leave blank/unset for local dev
# =============================================================================

# AWS deployment region
AWS_REGION=ap-northeast-1

# Cognito (production auth). When APP_ENV=development, auth is bypassed and
# these are ignored.
# COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
# COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# S3 bucket for output ZIPs. Leave empty in local dev — the pipeline keeps the
# ZIP on disk and serves it via /api/v1/jobs/{id}/download. Set this in
# production so the pipeline uploads and returns a presigned URL instead.
S3_BUCKET_NAME=

# Name of the pipeline Lambda. Leave empty in local dev — the API process
# runs the pipeline in-process via asyncio.create_task. Set this in production
# so the API Lambda asynchronously invokes the dedicated pipeline Lambda.
PIPELINE_LAMBDA_NAME=
