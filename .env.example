# LLM
GOOGLE_API_KEY=your-google-api-key
LLM_MODEL=gemini-2.5-pro-preview-05-06

# AWS
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET_NAME=arxiv-translator-output

# DynamoDB
DYNAMODB_TABLE_NAME=arxiv-translator-jobs
# DYNAMODB_ENDPOINT_URL=http://localhost:8100  # ローカル開発時のみ (Docker Compose で自動設定)

# Lambda (ローカル開発時は空のまま → asyncio.create_task でパイプライン実行)
# PIPELINE_LAMBDA_NAME=arxiv-translator-pipeline

# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
